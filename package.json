{
  "name": "fodprwebclient",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:api": "node api/server.mjs",
    "deploy": "pnpm build && mkdir -p /var/www/fodpr/assets && cp -r dist/assets/. /var/www/fodpr/assets/ && cp dist/index.html /var/www/fodpr/index.html && cp public/docs.html /var/www/fodpr/docs.html && echo \"deployed to /var/www/fodpr\""
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^9.8.8",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@dpawlikowski/liquid-glass": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.2"
  }
}
